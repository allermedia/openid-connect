{
  "name": "@aller/openid-connect",
  "version": "0.3.2",
  "description": "Express middleware to protect web applications using OpenID Connect.",
  "type": "module",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "author": {
    "name": "Aller Media",
    "url": "https://github.com/allermedia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allermedia/openid-connect.git"
  },
  "homepage": "https://github.com/allermedia/openid-connect",
  "license": "MIT",
  "files": [
    "src",
    "types/index.d.ts",
    "types/index.d.ts.map",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "mocha",
    "posttest": "npm run build && npm run lint && npm run test:md",
    "lint": "eslint . --cache && prettier . -c",
    "test:md": "texample",
    "cov:html": "c8 -n src -r html -r text mocha",
    "test:lcov": "c8 -n src -r lcov -r text mocha",
    "build": "dts-buddy && npm run toc",
    "prepack": "npm run build",
    "toc": "toc -c README.md"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "debug": "^4.4.1",
    "joi": "^18.0.2",
    "on-headers": "^1.1.0",
    "openid-client": "^6.8.1"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "^7.1.0",
      "yargs": "^18.1.0"
    }
  },
  "devDependencies": {
    "@0dep/toc": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.12",
    "@types/express": "5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/on-headers": "^1.0.4",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "dts-buddy": "^0.8.0",
    "eslint": "^10.3.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "jose-v2": "npm:jose@^2.0.7",
    "memorystore": "^1.6.8",
    "mocha": "^11.7.5",
    "mocha-cakes-2": "^3.3.0",
    "nock": "^14.0.10",
    "prettier": "^3.6.2",
    "supertest": "7.2.2",
    "texample": "^1.0.0"
  },
  "peerDependencies": {
    "express": ">= 4.17.0",
    "jose": "6.x"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
